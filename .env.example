# ChickenFarm 配置模板
# 使用方法：复制本文件为 .env（cp .env.example .env），填写真实值；.env 已被 .gitignore 忽略。

# ---- 数据库 ----
DB_USERNAME=
DB_PASSWORD=
DB_ADDRESS=localhost
DB_PORT=3306
DB_FUND=db_fund               # 回测标的清单库（仅含 tbl_funds_for_backtest）
DB_NETVALUE=db_netvalue       # 场外基金累计净值库
DB_BACKTEST=db_backtest       # 回测数据/结果库
DB_ETF=db_etf                 # ETF 日线行情库

# ---- 导出路径 ----
EXPORT_AIP_PLOT_PATH=

# ---- 回测参数（全部可选，缺省使用代码内默认值；取消注释即可覆盖）----
#BACKTEST_ETF_LOTS=1           # ETF 每期买入手数（1手=100份）
#BACKTEST_SPREAD=0.0005        # 尾盘买入相对价差（万5）
#BACKTEST_COMMISSION=0         # ETF 佣金率（免5账户可设0）
#BACKTEST_SLIPPAGE=0           # 滑点
#BACKTEST_FUND_FEE_DISCOUNT=0.1  # 场外申购费率折扣（一折=0.1）
#BACKTEST_SIGNIFICANCE_TEST=true # 配对显著性检验（false 回退裸中位数选最优日）
#BACKTEST_BOOTSTRAP=true       # 分块 bootstrap CI 误差线（false 同时不产出 CI CSV）
#BACKTEST_PLOT_METRIC=excess   # 小提琴口径：excess=同估值日相对 daily 的配对超额（默认，剔除市场β）/ absolute=绝对盯市收益率
#BACKTEST_RECENT_YEARS=1       # 估值日近期窗口（年）：默认只取最近1年的估值日；设0=全部历史
#BACKTEST_EXPORT_STATS=true    # 导出 p值/效应量/CI/稳健性到 stats/
#BACKTEST_FUND_TYPE_OVERRIDES={}  # 个别代码强制分类，如 {"510300":"etf","005827":"fund"}
#BACKTEST_SPLIT_FACTORS={}     # ETF 拆分因子，如 {"510300":{"2022-01-04":2.0}}
